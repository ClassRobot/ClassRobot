# Docker image that runs go_wcf_http + WeChatFerry in Wine.
WCF_IMAGE=jackytj/wcf-docker:latest
WCF_CONTAINER_NAME=classrobot-wechatferry

# Host ports.
# Open http://127.0.0.1:${WCF_VNC_PORT}/vnc.html to scan the WeChat login QR code.
WCF_VNC_PORT=8088
# HTTP API endpoint exposed to adapters and bridge services.
WCF_API_PORT=8000

# Optional message callback. Use a LAN-reachable URL when ClassRobot runs on the host.
# Multiple callback URLs are supported by the image with comma separation.
WCF_CALLBACK_URL=

WCF_SHM_SIZE=1g
TZ=Asia/Shanghai
